# The API `next dev` calls, as an origin with no path (the client adds /api/v1). Local development
# only: here it is the staging API. A build needs it set explicitly and stops without it (NEW-132);
# production builds use https://api.gymsera.com.
NEXT_PUBLIC_API_URL=https://apistaging.gymsera.com
NEXT_PUBLIC_APP_NAME=GymsEra
# The "Web application" OAuth client from Google Cloud Console — the same
# one gymsera_be's GOOGLE_CLIENT_ID already accepts as a valid audience, so
# no backend change is needed to reuse it. That client's own "Authorized
# JavaScript origins" (Cloud Console → Credentials) must separately include
# this site's real origin(s) — https://gymsera.com, https://www.gymsera.com,
# and http://localhost:3000 for local dev — or Google Identity Services
# fails silently in the browser console with an origin-mismatch error, not
# as an API error this app can catch.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=852595980857-akglkibm5auiu093lkrcr3cmqgf0oo3q.apps.googleusercontent.com

# Card (Stripe) option on the signup payment step. Keep off until a web payment provider is live.
NEXT_PUBLIC_WEB_CARD_PAYMENTS_ENABLED=false

# Google Maps web key (NEW-140, P9): draws the maps only (Maps JavaScript API): the gym page map and the
# registration pin. Address search and "Use my location" never use it: they go through the API's
# /places routes and its server key. Restrict it in Google Cloud to the Maps JavaScript API and HTTP
# referrers https://gymsera.com/* (add www.gymsera.com/* if that host is served; staging: its own host). Never commit the
# value. Empty = no map; search still works.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
