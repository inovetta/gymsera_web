NEXT_PUBLIC_API_URL=https://apistaging.gymsera.com
NEXT_PUBLIC_APP_NAME=GymsEra
# The "Web application" OAuth client from Google Cloud Console — the same
# one gymsera_be's GOOGLE_CLIENT_ID already accepts as a valid audience, so
# no backend change is needed to reuse it. That client's own "Authorized
# JavaScript origins" (Cloud Console → Credentials) must separately include
# this site's real origin(s) — https://gymsera.com, https://www.gymsera.com,
# and http://localhost:3000 for local dev — or Google Identity Services
# fails silently in the browser console with an origin-mismatch error, not
# as an API error this app can catch.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=852595980857-akglkibm5auiu093lkrcr3cmqgf0oo3q.apps.googleusercontent.com
